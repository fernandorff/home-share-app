# Local development. The Rust server reads these from the environment (it does not load this file):
# export them in the shell before `cargo run` in server/. `npm run db:migrate` (Prisma) reads .env.local / .env.
# Production values live only in Fly secrets and GitHub — never in a local file.

# Postgres local (Docker: `npm run db:up`, then `npm run db:migrate`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/homeshare_dev"
# Session signing secret (required).
JWT_SECRET="change-me-to-a-long-random-secret"
# `production` = the only deploy search engines may index (and its security headers).
APP_ENV=
# Google sign-in. Empty = button disabled. Redirect URI: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web Push (spec 010, ADR 0011): all three or none (empty = push off). Generate with
# `npx web-push generate-vapid-keys`. The public key is also built into the web app (Docker --build-arg).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push services (not localhost).
VAPID_SUBJECT=
# Sentry (spec 007). Empty = off. The VITE_ ones are built into the web app.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
