# Postgres local (Docker: `docker compose up -d`, depois `npm run db:migrate`).
# As URLs de produção e de staging (Neon, string pooled -pooler) ficam só na Vercel — nunca em .env / .env.local locais.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/homeshare_dev"
# Segredo do JWT (obrigatório em produção)
JWT_SECRET="troque-por-um-segredo-forte"
# Origins permitidos no CORS, separados por vírgula. Vazio = '*'
ALLOWED_ORIGINS=""
# Google OAuth (login com Google). Vazio = botão desabilitado.
# Redirect URI: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Sentry (observabilidade, spec 007). Vazio = desligado: o SDK não inicializa e o build não muda.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: amostragem de traces (0–1). Padrão: 0.1 em produção, 1.0 nos demais ambientes.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Só no build da Vercel, para enviar source maps. Nunca commitar valores.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Cron da Vercel (spec 008, ADR 0010): segredo do header Authorization: Bearer das rotas /api/cron/*.
# Vazio = as rotas de cron respondem 401 (fail-closed). A Vercel envia este valor sozinha nos Cron Jobs.
CRON_SECRET=
# Web Push (spec 010, ADR 0011): par de chaves VAPID + contato. Gere com `npx web-push generate-vapid-keys`.
# As três ou nenhuma: todas vazias = push desligado (o servidor não aceita inscrições nem envia pushes);
# só uma ou duas preenchidas = o build (e o `next dev`) para com erro, citando as que faltam.
# A chave pública vai para o navegador (NEXT_PUBLIC_, embutida no build); a privada nunca sai do servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou https: de contato para os serviços de push (não use localhost).
VAPID_SUBJECT=
